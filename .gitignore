# Large data / model outputs: ignore bulky subfolders in any outputs/ dir
# (use **/ to anchor at any depth), and any common heavy file formats.
# Writeups (*.md, *.tex, *.pdf, *.txt) inside outputs/ are kept — they are
# the only files explicitly added to git from outputs/.
**/outputs/experiments/
**/outputs/data/
**/outputs/temp/
**/outputs/tokenizer/
**/outputs/eval_results/
**/outputs/checkpoints/
**/outputs/output/
**/outputs/*.json
**/outputs/*.npz
**/outputs/*.pt
**/outputs/*.bin
wandb/

# Checkpoints and temp
memory_experiment/checkpoint/
validate_pretrained/output/

# Papers (PDFs)
memory_papers/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
*.egg

# Environment
.env
*.env

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Claude Code
.claude/
